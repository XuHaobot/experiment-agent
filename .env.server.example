# ===== 服务器侧配置模板（公网展示用你自己的 Key）=====
# 复制为 .env 后填入真实值；此文件不含密钥，可提交。
#
# 配置逻辑：
#   - 服务器带上这些 Key 后，访客打开站点即可直接使用（无需填 BYOK）。
#   - 前端的「⚙ 模型设置」面板仍可让访客填自己的 Key 覆盖（可选）。
#   - 只需 LLM_API_KEY 即可对话；DASHSCOPE_API_KEY 决定语义检索是否在线。

# —— 对话模型（必填，否则只能规则降级）——
# 示例：DeepSeek
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 示例：通义千问（也可同时用于对话+embedding，最省事）
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# —— 语义检索 Embedding（可选，但建议填，让语义搜索默认在线）——
# 用你自己的 DashScope/通义 Key 即可，与上方 LLM Key 可相同
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 启动时是否自动重建向量索引（默认 true；无 DASHSCOPE_API_KEY 时自动跳过）
AUTO_REBUILD_VECTORS=true

# ===== 公网只读模式（推荐用于求职展示站）=====
# true  = 禁用所有写接口（上传/新建实验/删除/重建索引），
#         访客只能对话 + 检索内置实验记录，会话按浏览器匿名隔离，互不串台。
# false = 完整功能（本地自用 / 可信环境）。
DEMO_READONLY=true
